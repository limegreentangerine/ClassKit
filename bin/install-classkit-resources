#!/usr/bin/env php
<?php

declare(strict_types=1);

if (!isset($_composer_autoload_path)) {
    fwrite(STDERR, "This command must be run through Composer.\n");
    exit(1);
}

$projectRoot = getcwd();

// install required npm packages
$commands = [
    [
        'npm',
        'install',
        '--save-dev',
        'typescript',
        'ts-loader',
        '@types/node',
        'svelte',
        'svelte-loader',
    ]
];

foreach ($commands as $command) {
    $process = proc_open(
        $command,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $projectRoot
    );

    if (!is_resource($process)) {
        throw new RuntimeException('Unable to start npm.');
    }

    $exitCode = proc_close($process);
    if ($exitCode !== 0) {
        exit($exitCode);
    }
}

echo "ClassKit resources installed" . PHP_EOL;
